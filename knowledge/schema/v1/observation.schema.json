{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oil-kb/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "required": ["id", "statement", "source", "publicationDate", "asOfDate", "scope", "provenance"],
  "properties": {
    "id": { "type": "string" },
    "statement": { "type": "string" },
    "source": { "type": "string" },
    "institution": { "type": "string" },
    "publicationDate": { "type": "string" },
    "asOfDate": { "type": "string" },
    "effectivePeriod": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "commodity": { "type": "string" },
        "geography": { "type": "string" },
        "metric": { "type": "string" },
        "unit": { "type": "string" }
      }
    },
    "value": {},
    "methodology": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "timeScale": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["documentId"],
      "properties": {
        "documentId": { "type": "string" },
        "page": { "type": ["integer", "null"] },
        "section": { "type": "string" },
        "quote": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
